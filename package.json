{
  "name": "mainspring",
  "version": "1.2.0",
  "private": true,
  "description": "A private, offline-first planner for financial independence. Wind it up — it drives everything.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tauri": "pnpm --filter desktop tauri",
