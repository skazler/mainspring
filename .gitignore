# ───────── Node / TypeScript / Vite (github/gitignore Node.gitignore) ─────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
node_modules/
coverage
*.lcov
.nyc_output
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
*.tgz
dist
.output
.svelte-kit/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# pnpm
.pnpm-store

# dotenv — keep the example, ignore the rest
.env
.env.*
!.env.example

# ───────── Rust / Cargo (github/gitignore Rust.gitignore) ─────────
target
debug
**/*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/

# ───────── Tauri ─────────
src-tauri/target/
src-tauri/gen/

# ───────── Local data (never commit financial data) ─────────
*.pglite
*.duckdb
*.sqlite
*.sqlite3
data/
*.parquet

# ───────── Local agent notes (keep shared AGENTS.md / CLAUDE.md, ignore personal) ─────────
CLAUDE.local.md

# ───────── OS / editor ─────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
